{
  "manifest_version": 3,
  "name": "AI Copilot (IG & WA)",
  "version": "1.1",
  "description": "Generates personalized AI replies for Instagram and WhatsApp DMs based on your style.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://web.whatsapp.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/direct/*",
        "https://web.whatsapp.com/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Configure AI Copilot",
    "default_popup": "options.html"
  }
}
